# ============================================================
# PROCESS EVENTS
# ============================================================

def process_events():

    while True:

        try:
            event = relay.events.get_nowait()
        except queue.Empty:
            break

        st.session_state.activity.insert(
            0,
            {
                "time": time.strftime(
                    "%H:%M:%S"
                ),
                **event,
            },
        )

        if len(st.session_state.activity) > 100:
            st.session_state.activity = (
                st.session_state.activity[:100]
            )

        if event["kind"] == "message":

            st.session_state.messages.append(
                event
            )

            if len(st.session_state.messages) > 100:
                st.session_state.messages = (
                    st.session_state.messages[-100:]
                )


process_events()


