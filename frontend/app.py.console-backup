PROTOCOL_VERSION = 1

PROTOCOL_TYPE_CLIENT_ID = 1
PROTOCOL_TYPE_MESSAGE = 2

BROADCAST_ID = 0

PROTOCOL_HEADER_SIZE = 46

CRYPTO_KEY_SIZE = 32
CRYPTO_NONCE_SIZE = 24
CRYPTO_MAC_SIZE = 16

PROTOCOL_MAX_PAYLOAD = 4096


# ============================================================
# PROTOCOL HELPERS
# ============================================================

def load_key(path):
    """
    Load the same 64-hex-character key format used by the
    C key manager.
    """
    path = Path(path)

    with open(path, "r", encoding="ascii") as f:
        raw = f.read(64)

    raw = raw.strip()

    if len(raw) != 64:
        raise ValueError(
            f"Invalid key length: expected 64 hex characters, "
            f"got {len(raw)}"
        )

    try:
        key = bytes.fromhex(raw)
    except ValueError as exc:
        raise ValueError("Key contains invalid hexadecimal characters") from exc

    if len(key) != CRYPTO_KEY_SIZE:
        raise ValueError(
            f"Invalid key length: expected {CRYPTO_KEY_SIZE} bytes, "
            f"got {len(key)}"
        )

    return key


def build_aad(header):
    """
    The C protocol authenticates:

        header bytes 0..21
        +
        header bytes 42..45

    Total AAD = 26 bytes.
    """
    if len(header) < PROTOCOL_HEADER_SIZE:
        raise ValueError("Header too short")

    return header[0:22] + header[42:46]


def build_message_frame(
    key,
    sender_id,
    target_id,
    sequence,
    plaintext,
):
    """
    Build the exact 46-byte-header relay protocol frame.
    """

    if len(plaintext) > PROTOCOL_MAX_PAYLOAD:
        raise ValueError("Payload exceeds protocol maximum")

    nonce = __import__("secrets").token_bytes(CRYPTO_NONCE_SIZE)

    # Header without nonce.
    header = bytearray(PROTOCOL_HEADER_SIZE)

    header[0] = PROTOCOL_VERSION
    header[1] = PROTOCOL_TYPE_MESSAGE

    struct.pack_into(
        "!I",
        header,
        2,
        sender_id,
    )

    struct.pack_into(
        "!I",
        header,
        6,
        target_id,
    )

    struct.pack_into(
        "!Q",
        header,
        10,
        sequence,
    )

    # Ciphertext length includes the 16-byte authentication tag.
    ciphertext_length = len(plaintext) + CRYPTO_MAC_SIZE

    struct.pack_into(
        "!I",
        header,
        18,
        ciphertext_length,
    )

    header[22:46] = nonce

    aad = build_aad(header)

    ciphertext = crypto_aead_xchacha20poly1305_ietf_encrypt(
        plaintext,
        aad,
        nonce,
        key,
    )

    return bytes(header) + ciphertext


def parse_frame(frame):
    """
    Parse a complete protocol frame.
    """

    if len(frame) < PROTOCOL_HEADER_SIZE:
        raise ValueError("Frame too short")

    version = frame[0]
    frame_type = frame[1]

    if version != PROTOCOL_VERSION:
        raise ValueError(
            f"Unsupported protocol version: {version}"
        )

    sender_id = struct.unpack_from("!I", frame, 2)[0]
    target_id = struct.unpack_from("!I", frame, 6)[0]
    sequence = struct.unpack_from("!Q", frame, 10)[0]
    ciphertext_length = struct.unpack_from("!I", frame, 18)[0]

    nonce = frame[22:46]

    if frame_type == PROTOCOL_TYPE_CLIENT_ID:

        if len(frame) != PROTOCOL_HEADER_SIZE:
            raise ValueError("Invalid client-ID frame length")

        return {
            "version": version,
            "type": frame_type,
            "sender_id": sender_id,
            "target_id": target_id,
            "sequence": sequence,
            "ciphertext_length": ciphertext_length,
            "nonce": nonce,
        }

    if frame_type != PROTOCOL_TYPE_MESSAGE:
        raise ValueError(
            f"Unsupported protocol type: {frame_type}"
        )

    if ciphertext_length < CRYPTO_MAC_SIZE:
        raise ValueError("Ciphertext too short")

    expected_length = (
        PROTOCOL_HEADER_SIZE + ciphertext_length
    )

    if len(frame) != expected_length:
        raise ValueError(
            f"Invalid frame length: expected {expected_length}, "
            f"got {len(frame)}"
        )

    return {
        "version": version,
        "type": frame_type,
        "sender_id": sender_id,
        "target_id": target_id,
        "sequence": sequence,
        "ciphertext_length": ciphertext_length,
        "nonce": nonce,
        "ciphertext": frame[PROTOCOL_HEADER_SIZE:],
        "header": frame[:PROTOCOL_HEADER_SIZE],
    }


def decrypt_message(key, frame):
    """
    Decrypt and authenticate a relay message.
    """

    info = parse_frame(frame)

    if info["type"] != PROTOCOL_TYPE_MESSAGE:
        raise ValueError("Frame is not a message")

    aad = build_aad(info["header"])

    plaintext = crypto_aead_xchacha20poly1305_ietf_decrypt(
        info["ciphertext"],
        aad,
        info["nonce"],
        key,
    )

    return plaintext, info


# ============================================================
# SOCKET HELPERS
# ============================================================

def recv_exact(sock, length):
    """
    Receive exactly length bytes.
    """

    data = bytearray()

    while len(data) < length:

        chunk = sock.recv(length - len(data))

        if not chunk:
            raise ConnectionError("Connection closed by server")

        data.extend(chunk)

    return bytes(data)


def recv_frame(sock):
    """
    Receive one complete protocol frame.

    Header is always 46 bytes.
    Message ciphertext length is stored at bytes 18..21.
    """

    header = recv_exact(sock, PROTOCOL_HEADER_SIZE)

    ciphertext_length = struct.unpack_from(
        "!I",
        header,
        18,
    )[0]

    if header[1] == PROTOCOL_TYPE_CLIENT_ID:

        if ciphertext_length != 0:
            raise ValueError("Invalid client-ID frame")

        return header

    if header[1] != PROTOCOL_TYPE_MESSAGE:
        raise ValueError(
            f"Unknown protocol type: {header[1]}"
        )

    if ciphertext_length < CRYPTO_MAC_SIZE:
        raise ValueError("Invalid ciphertext length")

    if ciphertext_length > PROTOCOL_MAX_PAYLOAD + CRYPTO_MAC_SIZE:
        raise ValueError("Ciphertext exceeds maximum payload")

    ciphertext = recv_exact(
        sock,
        ciphertext_length,
    )

    return header + ciphertext


# ============================================================
# RELAY CONNECTION
# ============================================================

class RelayConnection:

    def __init__(self):
        self.sock = None
        self.thread = None

        self.running = False
        self.connected = False

        self.client_id = None

        # Production relay starts incoming sequence at 1.
        self.next_sequence = 1

        self.key = None

        self.events = queue.Queue()

        self.lock = threading.Lock()

        self.sent_messages = 0
        self.received_messages = 0

        self.bytes_sent = 0
        self.bytes_received = 0

        self.connected_at = None

        self.known_peers = set()

    # --------------------------------------------------------
    # CONNECT
    # --------------------------------------------------------

    def connect(self, host, port, key):

        self.disconnect()

        self.key = key

        sock = socket.socket(
            socket.AF_INET,
            socket.SOCK_STREAM,
        )

        sock.settimeout(10)

        sock.connect(
            (host, port)
        )

        sock.settimeout(None)

        self.sock = sock
        self.running = True
        self.connected = True

        self.connected_at = time.time()

        self.next_sequence = 1

        self.thread = threading.Thread(
            target=self._receive_loop,
            daemon=True,
        )

        self.thread.start()

        self.events.put({
            "kind": "connected",
            "message": f"Connected to {host}:{port}",
        })

    # --------------------------------------------------------
    # RECEIVE LOOP
    # --------------------------------------------------------

    def _receive_loop(self):

        try:

            while self.running:

                frame = recv_frame(self.sock)

                self.bytes_received += len(frame)

                info = parse_frame(frame)

                if info["type"] == PROTOCOL_TYPE_CLIENT_ID:

                    self.client_id = info["target_id"]

                    self.events.put({
                        "kind": "client_id",
                        "client_id": self.client_id,
                        "message": (
                            f"Assigned client ID #{self.client_id}"
                        ),
                    })

                    continue

                plaintext, info = decrypt_message(
                    self.key,
                    frame,
                )

                sender_id = info["sender_id"]
                target_id = info["target_id"]
                sequence = info["sequence"]

                self.known_peers.add(sender_id)

                self.received_messages += 1

                try:
                    message = plaintext.decode(
                        "utf-8",
                        errors="replace",
                    )
                except Exception:
                    message = repr(plaintext)

                self.events.put({
                    "kind": "message",
                    "sender_id": sender_id,
                    "target_id": target_id,
                    "sequence": sequence,
                    "message": message,
                    "bytes": len(frame),
                })

        except Exception as exc:

            if self.running:

                self.events.put({
                    "kind": "error",
                    "message": str(exc),
                })

        finally:

            self.connected = False
            self.running = False

    # --------------------------------------------------------
    # SEND
    # --------------------------------------------------------

    def send_message(self, target_id, message):

        if not self.connected or self.sock is None:
            raise ConnectionError("Not connected")

        if self.client_id is None:
            raise RuntimeError(
                "Client ID has not been assigned yet"
            )

        plaintext = message.encode("utf-8")

        sequence = self.next_sequence

        frame = build_message_frame(
            self.key,
            self.client_id,
            target_id,
            sequence,
            plaintext,
        )

        with self.lock:

            self.sock.sendall(frame)

        self.next_sequence += 1

        self.sent_messages += 1
        self.bytes_sent += len(frame)

        self.events.put({
            "kind": "sent",
            "sender_id": self.client_id,
            "target_id": target_id,
            "sequence": sequence,
            "message": message,
            "bytes": len(frame),
        })

    # --------------------------------------------------------
    # DISCONNECT
    # --------------------------------------------------------

    def disconnect(self):

        self.running = False
        self.connected = False

        if self.sock is not None:

            try:
                self.sock.shutdown(
                    socket.SHUT_RDWR
                )
            except Exception:
                pass

            try:
                self.sock.close()
            except Exception:
                pass

        self.sock = None
        self.client_id = None


